PORT=5000
# No trailing slash. On Railway set this in Variables (not GitHub).
# Comma-separated list is also allowed.
CLIENT_URL=http://localhost:3000,https://mochawear.vercel.app

# Paste these from Supabase → Connect → Server / Build APIs
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
SUPABASE_SECRET_KEY=sb_secret_...
SUPABASE_JWKS_URL=https://your-project.supabase.co/auth/v1/.well-known/jwks.json

ADMIN_USERNAME=admin
ADMIN_PASSWORD=Admin@123
ADMIN_SECRET=change-this-secret

# Custom domains (Vercel API — resellers never open Vercel dashboard)
# Create token: Vercel → Settings → Tokens
# Project ID: Vercel project → Settings → General
VERCEL_TOKEN=
VERCEL_PROJECT_ID=
VERCEL_TEAM_ID=
STORE_CNAME_TARGET=cname.vercel-dns.com
STORE_APEX_A=76.76.21.21

# Google Drive media library (server-only — never use NEXT_PUBLIC_*)
# OAuth Web client from Google Cloud; callback must match exactly.
GOOGLE_DRIVE_CLIENT_ID=
GOOGLE_DRIVE_CLIENT_SECRET=
GOOGLE_DRIVE_REDIRECT_URI=http://localhost:5000/api/admin/media/drive/callback
# 32 random bytes as hex (64 chars). Generate separately from tokens.
GOOGLE_DRIVE_TOKEN_KEY=
